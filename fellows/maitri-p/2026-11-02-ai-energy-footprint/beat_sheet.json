    {
      "beat_id": "B01",
      "act": "TWO PLACES",
      "narration_text": "AI uses energy in two places. Training, a one-off cost for each model. And inference, every time someone asks it something.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "AgentToolLoop",
          "props": {
