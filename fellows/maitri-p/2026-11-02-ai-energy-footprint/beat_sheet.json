              "INFERENCE · EVERY ANSWER"
            ],
            "executeIndex": 1,
            "loopBack": false,
            "ports": [],
            "sparkLine": "Built once, used billions of times."
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-11-07T22:48:39.432086+00:00"
          }
        },
        "show": [
          {
            "at": 0.05,
