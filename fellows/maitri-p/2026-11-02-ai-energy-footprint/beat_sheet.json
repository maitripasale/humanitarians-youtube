          }
        ]
      },
      "estimated_duration_s": 8,
      "actual_duration_s": 8.7,
      "audio_file": "mp3/beat-B01.mp3"
    },
    {
      "beat_id": "B02",
      "act": "TRAINING",
      "narration_text": "Training GPT-3 ran ten thousand GPUs for about fifteen days, using around 1,287 megawatt-hours of electricity.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "LessonExcerpt",
          "props": {
            "header": "Training GPT-3",
            "subheader": "· a one-off cost",
            "rows": [
              {
                "tag": "CHIPS",
                "text": "10,000 GPUs for 14.8 days"
              },
              {
                "tag": "ENERGY",
                "text": "about 1,287 MWh",
                "emphasis": true
              },
              {
                "tag": "EMISSIONS",
                "text": "about 552 tonnes CO₂e"
              }
            ],
            "footer": "Source: Patterson et al., Google / UC Berkeley, 2021",
            "sparkLine": "Big, but only once."
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-11-07T22:49:40.365226+00:00"
