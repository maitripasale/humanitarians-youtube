    {
      "beat_id": "B05",
      "act": "2D VS 3D",
      "narration_text": "Not all phones work this way. Many Android phones use the ordinary front camera, and some can be fooled by a photo. 3D scans measure depth, so they're much harder to fool.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "LessonExcerpt",
          "props": {
            "header": "Not all phones",
            "subheader": "· 2D vs 3D",
            "rows": [
              {
                "tag": "2D CAMERA",
                "text": "convenient · some fooled by a photo"
              },
              {
                "tag": "3D SCAN",
                "text": "measures depth · much harder to fool",
                "emphasis": true
              }
            ],
            "footer": "Why many banking apps won't accept 2D face unlock",
            "sparkLine": "Depth is the difference."
          },
          "rendered": {
            "out": "media/B05.mp4",
