        "at": "2026-11-15T16:51:27"
      }
    },
    {
      "beat_id": "B01",
      "act": "CAPTURE",
      "narration_text": "Face ID shines over thirty thousand invisible infrared dots on your face. A camera reads how they bend and builds a 3D depth map, so a flat photo won't work.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "LessonExcerpt",
          "props": {
            "header": "Capture",
            "subheader": "· Apple Face ID",
            "rows": [
              {
                "tag": "DOT PROJECTOR",
                "text": "30,000+ invisible infrared dots"
              },
              {
                "tag": "IR CAMERA",
                "text": "reads the dots → 3D depth map",
                "emphasis": true
              },
              {
                "tag": "FLOOD LIGHT",
                "text": "infrared light, works in the dark"
              }
            ],
            "footer": "A flat photo has no depth",
            "sparkLine": "It measures shape, not looks."
          },
          "rendered": {
            "out": "media/B01.mp4",
            "at": "2026-11-15T22:42:25.542703+00:00"
          }
        }
      },
      "estimated_duration_s": 10,
      "actual_duration_s": 10.9,
      "audio_file": "mp3/beat-B01.mp3",
      "render_duration_s": 10.916666666666666,
      "build": {
        "status": "VIDEO",
        "src": "media\\B01.mp4",
        "filled_by": "remotion:LessonExcerpt",
        "at": "2026-11-15T16:51:27"
      }
    },
    {
      "beat_id": "B02",
      "act": "EMBEDDING",
      "narration_text": "A neural network turns that scan into a long list of numbers. Similar faces give similar numbers. Each unlock compares a new list to the saved one, and if they're close enough, it opens.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "AgentToolLoop",
          "props": {
            "stages": [
              "SCAN",
              "NUMBERS",
              "COMPARE",
              "UNLOCK"
            ],
            "executeIndex": 1,
            "loopBack": false,
            "ports": [],
            "sparkLine": "Close numbers, same face."
          },
          "rendered": {
            "out": "media/B02.mp4",
            "at": "2026-11-15T22:43:25.031427+00:00"
          }
        },
        "show": [
          {
            "at": 0.05,
            "event": "scan → numbers → compare → unlock"
          }
        ]
      },
      "estimated_duration_s": 12,
      "actual_duration_s": 11.8,
      "audio_file": "mp3/beat-B02.mp3",
      "render_duration_s": 11.833333333333334,
      "build": {
        "status": "VIDEO",
        "src": "media\\B02.mp4",
        "filled_by": "remotion:AgentToolLoop",
        "at": "2026-11-15T16:51:27"
      }
    },
    {
      "beat_id": "B03",
      "act": "THRESHOLD",
      "narration_text": "Where to draw that line is a trade-off: stricter keeps strangers out, but fails you more often. It also checks that your eyes are open, and adapts as your face changes.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "LessonExcerpt",
          "props": {
            "header": "The threshold",
            "subheader": "· how close is close enough",
            "rows": [
              {
                "tag": "STRICTER",
                "text": "fewer strangers get in · more fails for you",
                "emphasis": true
              },
              {
                "tag": "LOOSER",
                "text": "easier for you · easier for others"
              },
              {
                "tag": "ATTENTION",
                "text": "eyes open and looking at the phone"
              },
              {
                "tag": "ADAPTS",
                "text": "follows beards, glasses, ageing"
              }
            ],
            "footer": "",
            "sparkLine": "A line someone has to draw."
          },
          "rendered": {
            "out": "media/B03.mp4",
            "at": "2026-11-15T22:44:24.685544+00:00"
          }
        }
      },
      "estimated_duration_s": 11,
      "actual_duration_s": 10.69,
      "audio_file": "mp3/beat-B03.mp3",
      "render_duration_s": 10.708333333333334,
      "build": {
        "status": "VIDEO",
        "src": "media\\B03.mp4",
