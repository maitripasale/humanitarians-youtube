    },
    {
      "beat_id": "B04",
      "act": "PRIVACY",
      "narration_text": "The face data stays encrypted on the phone, in the Secure Enclave. Apple says a random stranger has under a one-in-a-million chance, higher for twins and children under 13.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "illustrate",
        "remotion": {
          "pattern": "LessonExcerpt",
          "props": {
            "header": "Privacy and accuracy",
            "subheader": "· Apple's figures",
            "rows": [
              {
                "tag": "STORED",
                "text": "Secure Enclave · on the phone, not iCloud"
              },
              {
                "tag": "RANDOM MATCH",
                "text": "under 1 in 1,000,000",
                "emphasis": true
              },
              {
                "tag": "HIGHER FOR",
                "text": "twins, look-alike siblings, under 13"
              }
            ],
            "footer": "Source: Apple, About Face ID advanced technology",
            "sparkLine": "Private, and hard to fool."
          },
          "rendered": {
