    {
      "beat_id": "B00",
      "act": "ASK",
      "narration_text": "Hi, I am Maitri and this video is about how your phone recognizes your face. Surprisingly, it doesn't store your photo.",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "type-on",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Ciao, HAI",
            "topic": "Irreducibly Human",
            "segment": "Face Unlock",
            "command": "How does my phone recognize my face?",
            "runningText": "scanning…",
            "folderLabel": "@HumanitariansAI",
            "output": [
              "not a photo",
              "a list of numbers"
            ]
          },
          "rendered": {
            "out": "media/B00.mp4",
            "at": "2026-11-15T22:41:25.568236+00:00"
          }
        }
      },
      "estimated_duration_s": 7,
      "actual_duration_s": 7.81,
      "audio_file": "mp3/beat-B00.mp3",
      "render_duration_s": 7.833333333333333,
      "build": {
